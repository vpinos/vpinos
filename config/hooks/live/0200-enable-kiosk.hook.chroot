#!/bin/sh
set -e

# Everything VPinOS-specific -- the menu, launcher, config tool, root
# helpers, sudoers rules, profile.d auto-launch, motd banner, systemd
# units and drop-ins, log files and the /etc/vpinos defaults -- now
# comes from the vpinos-core package (0100-install-vpinos-packages.hook.chroot),
# which sets its own ownership/modes and enables its own units. What's
# left here is base-OS setup for files other Debian packages own.

# Blanked out -- base-files' default /etc/motd ships Debian's stock
# free-software/no-warranty boilerplate, which `pam_motd.so noupdate`
# (the second pam_motd rule in /etc/pam.d/sshd) prints on every SSH
# login unconditionally, on top of (not instead of) vpinos-core's
# dynamic banner. Not generated by any tracked package (confirmed via
# `dpkg -S /etc/motd` -- no match), so there's nothing to reconfigure,
# just this file's own content to override. Empty, not deleted: an
# absent /etc/motd would leave whatever base-files reinstalls it with
# on a future apt operation, and pam_motd treats an empty file as
# silently printing nothing, which is what's wanted.
chown root:root /etc/motd
chmod 0644 /etc/motd

# Standard Debian ownership/mode for this file -- pins the console
# font variant (see the file's own comment for why its auto-picked
# default wasn't enough), read by setupcon's systemd unit at boot.
chown root:root /etc/default/console-setup
chmod 0644 /etc/default/console-setup

systemctl set-default multi-user.target
systemctl enable seatd.service
systemctl enable NetworkManager.service

# includes.chroot doesn't reliably give files the right ownership/mode:
# mode comes through as-is from the (unprivileged) build host, and
# ownership is inconsistent -- /etc/os-release was confirmed to come
# through as the build host's uid, which is `vpinos` inside the image
# (i.e. writable by the kiosk user). So it's set explicitly here.
chown root:root /etc/os-release
chmod 0644 /etc/os-release

# Read by vpinos-core's preinst to refuse installing on an image older
# than it supports -- must not be writable by the kiosk user either.
chown root:root /usr/share/vpinos/base-version
chmod 0644 /usr/share/vpinos/base-version

# No systemd service for Hyprland itself -- boot goes to a normal console
# (auto-launching vpinos-menu, see vpinos-core's
# /etc/profile.d/vpinos-menu.sh). Picking a menu option runs
# vpinos-launch, which execs Hyprland directly (inheriting the caller's
# tty/session) and launches the chosen client as its client once the
# Wayland socket is up.
