#!/bin/sh
set -e

# config/includes.chroot_before_packages/etc/dpkg/dpkg.cfg.d/01-vpinos-trim
# excludes /usr/share/locale (non-English), /usr/share/doc, /usr/share/man,
# /usr/share/info and /usr/share/groff for every package dpkg unpacks from
# here on -- but it can't retroactively apply to the base system debootstrap
# already unpacked before that config file existed in the chroot (bash,
# coreutils, perl-base, sed, grep, tar, dpkg, apt, libc-bin, and the rest of
# minbase). Confirmed directly on a real built chroot: after the dpkg
# exclude alone, /usr/share/locale (coreutils.mo etc, 45+ languages) was
# still 43M, /usr/share/doc (e.g. sudo/copyright) still 12M, /usr/share/man
# (e.g. bash.1.gz) still 8.5M -- all traceable to packages present before
# our dpkg config landed, confirmed via `ls usr/share/locale/*/LC_MESSAGES/
# coreutils.mo` returning hits where the equivalent lookup for a
# later-installed package (calamares.mo) returned none.
#
# Sweeping the remainder directly here, same as the dpkg excludes: this is
# a single-purpose English-language kiosk with no interactive `man` usage
# expected. dpkg's own md5sums database will now disagree with what's on
# disk for these specific base packages (dpkg -V would flag it) -- the same
# already-accepted tradeoff the dpkg path-exclude config makes for every
# other package, just applied by hand for the handful dpkg couldn't reach.
find /usr/share/locale -mindepth 1 -maxdepth 1 \
  ! -name 'en' ! -name 'en_*' ! -name locale.alias -exec rm -rf {} +
rm -rf /usr/share/doc/* /usr/share/man/* /usr/share/info/* /usr/share/groff/*
