# TEMPORARY -- requested directly, to be removed in the future (no
# tracking issue yet; just delete this file and its `systemctl enable`
# line in 0200-enable-kiosk.hook.chroot when it's no longer needed).
# Forces CompressTextures = 0 for the bundled example table via a
# per-table ini override (VPinballX_BGFX reads <table>.ini next to
# <table>.vpx for table-specific setting overrides) -- not written into
# config/includes.chroot directly as a static file because /opt/vpinball
# is owned by the vpinball package itself (dpkg), not this project, so a
# baked-in file there wouldn't survive a package upgrade/reinstall the
# way a boot-time rewrite does.
#
# Same ordering requirement as vpinos-hosts.service, same reason: root
# boots `ro` and systemd-remount-fs.service is what remounts it rw per
# fstab, confirmed there via a real `status=2/INVALIDARGUMENT` failure
# without this. Runs unconditionally on every boot (harmless to rewrite
# identical content each time) rather than only if missing, in case a
# vpinball package update ever ships its own exampleTable.ini and
# overwrites this one.
[Unit]
Description=VPinOS: TEMPORARY -- force CompressTextures=0 for the example table
After=systemd-remount-fs.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'printf "[Player]\n; Compress Textures: Compress textures to GPU formats to reduce memory use (slow on first load, cached afterwards) [Default: 1]\nCompressTextures = 0\n" > /opt/vpinball/assets/exampleTable.ini'

[Install]
WantedBy=multi-user.target
