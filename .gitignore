# Personal working notes -- never committed
/notes/

# Build output (see notes/vpinos.md's Directory reference)
/dist/

# live-build's own build-time workspace -- regenerated by every `lb
# build`, wiped by `lb clean`, never part of the shipped image or
# meant to be committed
/chroot/
/binary/
/cache/
/.build/
/local/
/.lock

# Stray build byproducts if a build is interrupted before its
# `dist/`-move step runs
/live-image-amd64.*
/chroot.*
/binary.*

# Python bytecode cache -- created wherever a .py file under
# config/includes.chroot/ gets syntax-checked directly with `python3`
# (e.g. `python3 -m py_compile`) on the build host, not part of the
# shipped image
__pycache__/
*.pyc

# Local test builds only: vpinos-core .debs installed by
# 0100-install-vpinos-packages.hook.chroot instead of the published one.
/config/includes.chroot/var/cache/vpinos-local-debs/
